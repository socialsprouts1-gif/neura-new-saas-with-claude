# Supabase
# Project Settings -> API in the Supabase dashboard.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
# Server-only. Bypasses RLS — never expose to the client. Used only by the
# WhatsApp webhook handler (an unauthenticated route with no user session).
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Meta / WhatsApp Cloud API
# App Secret from your Meta App's Basic Settings — used to verify the
# X-Hub-Signature-256 header on every incoming webhook call.
META_APP_SECRET=your-meta-app-secret
# Default/system access token for the Meta app (per-org tokens are stored,
# encrypted, in waba_connections.access_token_encrypted instead).
META_ACCESS_TOKEN=your-meta-access-token

# Encryption
# 32 random bytes, base64-encoded. Generate with: openssl rand -base64 32
# Used to encrypt/decrypt waba_connections.access_token_encrypted.
TOKEN_ENCRYPTION_KEY=your-base64-32-byte-key
